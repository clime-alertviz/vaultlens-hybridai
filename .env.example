# Optional Firebase Web App Config (from Firebase Console -> Project Settings)
# If omitted, users/judges can still paste config at runtime in the "Setup Firebase" modal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Firebase App Check (reCAPTCHA v3 site key from Firebase Console -> App Check)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# For local testing / hackathon judging debug builds, set a debug token or "true"
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Optional local build settings for the official payment QR.
# Without them, the Pro button opens the hosted VaultLens product.
VITE_VAULTLENS_PAYMENT_IBAN=
VITE_VAULTLENS_DOMESTIC_ACCOUNT=
